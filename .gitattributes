# Normalize text files to LF in the repo, auto-convert on checkout per OS
* text=auto eol=lf

# Binary files — never munge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Lockfiles: keep LF, merge as union to reduce conflicts
package-lock.json text eol=lf