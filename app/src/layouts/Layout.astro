---
import '../styles/global.css';
import Header from '../components/Header.astro';
import PlexusBackground from '../components/PlexusBackground.astro';
import CustomCursor from '../components/CustomCursor.astro';
import ChatWidget from '../components/ChatWidget.astro';
import RevealOnScroll from '../components/RevealOnScroll.astro';

interface Props {
	title?: string;
	lang?: 'vi' | 'en';
}

const { title = "The Investigator Terminal", lang = 'en' } = Astro.props;
---

<!doctype html>
<html lang={lang === 'vi' ? 'vi' : 'en'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="AI Engineer & Full-Stack Developer — building intelligent systems that solve real-world problems." />
		<title>{title}</title>

		<!-- The Investigator typography: Rajdhani (display) + Inter (body) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
		/>
	</head>
	<body class="bg-bg text-text-primary font-body antialiased min-h-screen relative overflow-x-hidden selection:bg-green/30 selection:text-text-primary">
		<!-- Background FX (z-0, below vignette z-1) -->
		<PlexusBackground />

		<Header lang={lang} />
		<slot />

		<!-- Foreground FX (z high) -->
		<ChatWidget lang={lang} />
		<CustomCursor />
		<RevealOnScroll />
	</body>
</html>
