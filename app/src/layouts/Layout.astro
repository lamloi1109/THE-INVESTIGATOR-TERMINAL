---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = "THE INVESTIGATOR TERMINAL" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="AI Engineer Portfolio showcasing system architecture, RAG, and structured outputs." />
		<title>{title}</title>
	</head>
	<body class="bg-white text-zinc-900 font-sans antialiased selection:bg-zinc-200 selection:text-zinc-900">
		<slot />
	</body>
</html>
