---
/**
 * /projects — Projects listing page (SSG)
 * Task: T-021
 *
 * Fetch projects từ Google Sheets (schema v2.0). Fallback sang
 * app/src/data/projects.ts khi Sheets unavailable (giống pattern T-022).
 * Card có case study (problem + solution + result) link tới
 * /case-studies/[slug]; còn lại render disabled state (no link).
 *
 * Zero JS — pure Astro markup. SSG via prerender = true.
 */
import Layout from '../../layouts/Layout.astro';
import { fetchSheet } from '../../lib/sheets';
import { projects as fallbackProjects } from '../../data/projects';

export const prerender = true;

interface ProjectCard {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  date: string;
  icon: string;
  iconVariant: 'cyan' | 'green' | 'pink';
  hasCaseStudy: boolean;
}

const currentLang: 'vi' | 'en' = 'vi';

function pickVariant(raw: string | undefined, fallback: 'cyan' | 'green' | 'pink'): 'cyan' | 'green' | 'pink' {
  if (raw === 'cyan' || raw === 'green' || raw === 'pink') return raw;
  return fallback;
}

let cards: ProjectCard[] = [];

try {
  const rows = await fetchSheet('Projects');
  cards = rows.map((p, i) => {
    const variants: Array<'cyan' | 'green' | 'pink'> = ['cyan', 'green', 'pink'];
    return {
      slug: p.slug || p.id,
      title: currentLang === 'vi' ? (p.title_vi || p.title_en) : (p.title_en || p.title_vi),
      description: currentLang === 'vi'
        ? (p.description_vi || p.description_en || '')
        : (p.description_en || p.description_vi || ''),
      tags: p.tags || [],
      date: p.date || '',
      icon: p.icon || '▸',
      iconVariant: pickVariant(p.icon_variant, variants[i % 3]),
      hasCaseStudy: !!(p.slug && p.problem_vi && p.solution_vi && p.result_vi),
    };
  });
} catch (error) {
  console.warn('[projects] Google Sheets unavailable; using static fallback.', error);
}

if (cards.length === 0) {
  cards = fallbackProjects.map((p) => ({
    slug: p.slug,
    title: p.name,
    description: p.desc,
    tags: p.tags,
    date: '',
    icon: p.icon,
    iconVariant: p.iconVariant,
    hasCaseStudy: !!(p.problem && p.solution && p.result),
  }));
}

const tHeader = currentLang === 'vi' ? 'Dự án' : 'Projects';
const tSubtitle = currentLang === 'vi'
  ? 'Tổng hợp các dự án thực tế — click vào card có nhãn "Case Study" để đọc chi tiết.'
  : 'Real-world projects — click any "Case Study" card to read the deep dive.';
const tCaseStudyBadge = currentLang === 'vi' ? 'Case Study →' : 'Case Study →';
const tBack = currentLang === 'vi' ? '← Trang chủ' : '← Home';
const tCount = currentLang === 'vi' ? `${cards.length} dự án` : `${cards.length} projects`;
---

<Layout title={`${tHeader} | The Investigator`} lang={currentLang}>
  <main class="relative z-[2] w-full">
    <section class="projects-page" aria-labelledby="projects-page-title">
      <div class="pp-nav reveal">
        <a href="/" class="pp-back-link">{tBack}</a>
      </div>

      <header class="pp-header reveal">
        <div class="section-label">Portfolio</div>
        <h1 class="pp-title" id="projects-page-title">{tHeader}</h1>
        <p class="pp-subtitle">{tSubtitle}</p>
        <div class="pp-count" aria-live="polite">{tCount}</div>
      </header>

      <div class="divider"></div>

      <div class="projects-grid">
        {cards.map((p) => {
          const Tag = p.hasCaseStudy ? 'a' : 'article';
          const props = p.hasCaseStudy
            ? { href: `/case-studies/${p.slug}`, class: 'project-card project-card--linked reveal' }
            : { class: 'project-card reveal' };
          return (
            <Tag {...props}>
              <div class={`project-icon pi-${p.iconVariant}`} aria-hidden="true">{p.icon}</div>
              <div class="project-name">{p.title}</div>
              <div class="project-desc">{p.description}</div>
              {p.tags.length > 0 && (
                <div class="project-tags">
                  {p.tags.map((t) => (<span class="tag">{t}</span>))}
                </div>
              )}
              <div class="project-meta">
                {p.date && <time class="project-date" datetime={p.date}>{p.date}</time>}
                {p.hasCaseStudy && <span class="project-cs-badge">{tCaseStudyBadge}</span>}
              </div>
            </Tag>
          );
        })}
      </div>
    </section>
  </main>
</Layout>

<style>
  .projects-page {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 48px 80px;
  }
  @media (max-width: 768px) {
    .projects-page { padding: 100px 24px 64px; }
  }

  .pp-nav { margin-bottom: 32px; }
  .pp-back-link {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-cyan);
    text-decoration: none;
    letter-spacing: 0.02em;
    opacity: 0.8;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .pp-back-link:hover { color: var(--color-green); opacity: 1; }

  .pp-header { margin-bottom: 32px; }
  .pp-title {
    font-family: var(--font-headline);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    background: linear-gradient(90deg, #fff 60%, rgba(0, 229, 255, 0.6));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 12px;
  }
  .pp-subtitle {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }
  .pp-count {
    margin-top: 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-cyan);
    text-transform: uppercase;
    opacity: 0.7;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    margin-top: 32px;
  }

  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 28px;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    color: inherit;
  }
  .project-card:hover {
    border-color: rgba(0, 229, 255, 0.25);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
  }
  .project-card--linked {
    cursor: pointer;
  }
  .project-card--linked:hover {
    border-color: rgba(0, 229, 255, 0.45);
  }

  /* Scan-line FX — same as homepage Projects.astro */
  .project-card::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0, 229, 255, 0.5), transparent);
    top: -2px;
    transition: top 0.6s ease;
    pointer-events: none;
  }
  .project-card:hover::after { top: 100%; }

  .project-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }
  .pi-cyan  { background: rgba(0, 229, 255, 0.10); border: 1px solid rgba(0, 229, 255, 0.20); }
  .pi-green { background: rgba(0, 255, 159, 0.10); border: 1px solid rgba(0, 255, 159, 0.20); }
  .pi-pink  { background: rgba(255, 0, 255, 0.08); border: 1px solid rgba(255, 0, 255, 0.20); }

  .project-name {
    font-family: var(--font-headline);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .project-desc {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-text-secondary);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 11.5px;
    letter-spacing: 0.04em;
  }
  .project-date {
    color: var(--color-text-secondary);
    opacity: 0.7;
  }
  .project-cs-badge {
    margin-left: auto;
    color: var(--color-cyan);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card { transition: none; }
    .project-card:hover { transform: none; }
    .project-card::after { display: none; }
  }
</style>
