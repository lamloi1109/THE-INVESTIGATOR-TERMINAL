---
/**
 * index.astro — Homepage (SSG)
 * T-026: fetches Profile sheet centrally and passes resolved strings to Hero.
 * Other sections (Experience/TechStack/Education/Contact) own their own
 * fetchSheet() calls — Sheets SWR cache de-duplicates concurrent loads.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import { getProfile, type Lang } from '../lib/profile';

export const prerender = true;

// Vietnamese translation of the default English portfolio.
const currentLang: Lang = 'vi';

const profile = await getProfile(currentLang);
---

<Layout title={`${profile.name} — IT Engineer`} lang={currentLang} hideChatWidget>
  <main class="relative z-[2] w-full">
    <Hero
      name={profile.name}
      badge={profile.hero_badge}
      tagline={profile.hero_tagline}
      aboutLabel={profile.hero_about_label}
      aboutBody={profile.hero_about_body}
      status={profile.hero_status}
      resumeHref={profile.resume_url}
      projectsHref="/vi#projects"
      contactHref="/vi#contact"
      lang={currentLang}
    />
    <div class="divider"></div>
    <Experience lang={currentLang} />
    <div class="divider"></div>
    <Projects lang={currentLang} />
    <div class="divider"></div>
    <TechStack lang={currentLang} />
    <div class="divider"></div>
    <Education lang={currentLang} />
    <div class="divider"></div>
    <Contact lang={currentLang} />
    <footer class="footer">
      {profile.name} · IT Engineer © 2026
    </footer>
  </main>
</Layout>
