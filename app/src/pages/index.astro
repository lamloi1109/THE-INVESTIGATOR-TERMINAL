---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';

// FIXTURE — replace with fetchSheet('Profile') when wiring lands.
// import { fetchSheet } from '../lib/sheets';
// const profiles = await fetchSheet('Profile');
// Map array -> object: profiles.reduce((acc, r) => ({ ...acc, [r.key]: r }), {});

export const prerender = true;

// Default UI language. VI matches design/index.html mockup verbatim.
const currentLang: 'vi' | 'en' = 'vi';

const profileFixture = {
  // 'name' is a proper noun — no i18n.
  name: 'Lam Phuoc Loi',
};
---

<Layout title={`${profileFixture.name} — The Investigator`} lang={currentLang}>
  <main class="relative z-[2] w-full">
    <Hero
      name={profileFixture.name}
      lang={currentLang}
    />
    <div class="divider"></div>
    <Experience />
    <div class="divider"></div>
    <Projects />
    <div class="divider"></div>
    <TechStack />
    <div class="divider"></div>
    <Education />
    <div class="divider"></div>
    <Contact />
    <footer class="footer">
      Built with ⚡ by Lam Loi · The Investigator Terminal © 2026
    </footer>
  </main>
</Layout>
