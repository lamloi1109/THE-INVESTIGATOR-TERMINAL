---
/**
 * Projects.astro — "Dự án nổi bật" section (6 cards)
 * Source: design/index.html lines 1605-1648 (markup) + 1509-1525 + 1799-1811 (CSS).
 *
 * Auto-fill grid (min 320px). Each card: icon (cyan/green/pink variant) +
 * name + description + tags. Hover triggers a horizontal cyan scan-line that
 * sweeps top → bottom over 0.6s, plus card lift.
 */

interface Project {
  icon: string;
  iconVariant: 'cyan' | 'green' | 'pink';
  name: string;
  desc: string;
  tags: string[];
}

interface Props { lang?: 'vi' | 'en'; }
const { lang = 'en' } = Astro.props;

const projectsVi: Project[] = [
  {
    icon: '🏭',
    iconVariant: 'cyan',
    name: 'QR010 · Hệ thống truy xuất sản xuất ắc quy',
    desc: 'Phát triển và cải tiến ứng dụng quét QR theo dõi chuyển động ắc quy từ đóng gói qua châm axit đến hoàn thiện; tích hợp cơ sở dữ liệu và quy trình BI.',
    tags: ['C#/.NET WinForms', 'Oracle SQL', 'MySQL', 'Pentaho ETL', 'SAP BI'],
  },
  {
    icon: '🧪',
    iconVariant: 'green',
    name: 'VSF017 · Giám sát châm axit',
    desc: 'Thu thập dữ liệu châm axit từ thiết bị sản xuất, kiểm tra kết quả theo thông số quy trình, trực quan hóa dữ liệu khối lượng và tạo hồ sơ phục vụ giám sát, đánh giá CPK.',
    tags: ['C#/.NET WinForms', 'SQLite', 'Oracle SQL', 'PLC Integration'],
  },
  {
    icon: '🌡️',
    iconVariant: 'pink',
    name: 'Giám sát môi trường hướng sự kiện',
    desc: 'Thiết kế luồng theo dõi dữ liệu môi trường bằng file-system events và socket communication, thay thế cơ chế kiểm tra thư mục lặp lại.',
    tags: ['C#/.NET', 'File System Events', 'Socket', 'Realtime'],
  },
  {
    icon: '🌱',
    iconVariant: 'green',
    name: 'Theo dõi CO₂ trong sản xuất',
    desc: 'Phát triển quy trình ERP T100 và PHP API liên kết đơn hàng, thành phẩm và dữ liệu CO₂ cấp linh kiện để phục vụ truy xuất và báo cáo.',
    tags: ['T100 ERP', 'PHP API', 'Oracle SQL', 'Manufacturing'],
  },
  {
    icon: '⌂',
    iconVariant: 'pink',
    name: 'HOMESTAY · Landing Page',
    desc: 'Dự án part-time đang phát triển: xây dựng landing page giới thiệu HOMESTAY với giao diện hiện đại, trực quan và tương thích trên nhiều thiết bị.',
    tags: ['Part-time', 'Landing Page', 'Responsive UI'],
  },
];

const projectsEn: Project[] = [
  {
    icon: '🏭', iconVariant: 'cyan',
    name: 'QR010 · Battery Production Traceability System',
    desc: 'Developed and improved a QR-based application tracing battery movement from casing through acid filling and final packaging, integrated with databases and BI workflows.',
    tags: ['C#/.NET WinForms', 'Oracle SQL', 'MySQL', 'Pentaho ETL', 'SAP BI'],
  },
  {
    icon: '🧪', iconVariant: 'green',
    name: 'VSF017 · Acid Filling Monitoring System',
    desc: 'Collected acid-filling measurements from production equipment, validated results against process specifications, visualised weight data, and generated monitoring and CPK records.',
    tags: ['C#/.NET WinForms', 'SQLite', 'Oracle SQL', 'PLC Integration'],
  },
  {
    icon: '🌡️', iconVariant: 'pink',
    name: 'Event-Driven Environment Monitor',
    desc: 'Designed an environmental data workflow based on file-system events and socket communication to replace repeated directory polling.',
    tags: ['C#/.NET', 'File System Events', 'Socket', 'Realtime'],
  },
  {
    icon: '🌱', iconVariant: 'green',
    name: 'Production CO₂ Tracking',
    desc: 'Developed T100 ERP and PHP API workflows connecting orders, finished products, and component-level CO₂ data for traceability and reporting.',
    tags: ['T100 ERP', 'PHP API', 'Oracle SQL', 'Manufacturing'],
  },
  {
    icon: '⌂', iconVariant: 'pink',
    name: 'HOMESTAY · Landing Page',
    desc: 'An in-progress part-time project: building a modern, visual, and responsive landing page to showcase HOMESTAY.',
    tags: ['Part-time', 'Landing Page', 'Responsive UI'],
  },
];

const projects = lang === 'vi' ? projectsVi : projectsEn;
const sectionTitle = lang === 'vi' ? 'Dự án nổi bật' : 'Selected Projects';
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="reveal">
    <div class="section-label">Portfolio</div>
    <div class="section-title" id="projects-title">{sectionTitle}</div>
  </div>
  <div class="projects-grid">
    {projects.map((p) => (
      <article class="project-card reveal">
        <div class={`project-icon pi-${p.iconVariant}`} aria-hidden="true">{p.icon}</div>
        <div class="project-name">{p.name}</div>
        <div class="project-desc">{p.desc}</div>
        <div class="project-tags">
          {p.tags.map((t) => (<span class="tag">{t}</span>))}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 28px;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .project-card:hover {
    border-color: rgba(0, 229, 255, 0.25);
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
  }

  /* Scan-line FX: horizontal cyan sweep top → bottom on hover */
  .project-card::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0, 229, 255, 0.5), transparent);
    top: -2px;
    transition: top 0.6s ease;
    pointer-events: none;
  }
  .project-card:hover::after { top: 100%; }

  .project-icon {
    width: 48px; height: 48px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }
  .pi-cyan  { background: rgba(0, 229, 255, 0.10); border: 1px solid rgba(0, 229, 255, 0.20); }
  .pi-green { background: rgba(0, 255, 159, 0.10); border: 1px solid rgba(0, 255, 159, 0.20); }
  .pi-pink  { background: rgba(255, 0, 255, 0.08); border: 1px solid rgba(255, 0, 255, 0.20); }

  .project-name {
    font-family: var(--font-headline);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-text-primary);
  }
  .project-desc {
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    flex: 1;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card { transition: none; }
    .project-card:hover { transform: none; }
    .project-card::after { display: none; }
  }
</style>
