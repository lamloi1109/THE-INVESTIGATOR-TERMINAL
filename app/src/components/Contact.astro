---
/**
 * Contact.astro — "Liên hệ" section: 4 contact cards + closing CTA
 * Source: design/index.html lines 1731-1760 (markup) + 1558-1573 + 1827-1859 (CSS).
 *
 * T-026: reads Profile keys (email, linkedin_url, github_url, location,
 * contact_cta_*) via `getProfile()` — falls back to committed defaults when
 * Sheets unavailable. 4 contact cards are derived from profile fields; their
 * static styling (icon variant) stays in the component.
 */
import { getProfile, type Lang } from '../lib/profile';

interface Props { lang?: Lang; }
const { lang = 'vi' } = Astro.props;

const profile = await getProfile(lang);

interface ContactCard {
  href: string;
  icon: string;
  iconVariant: 'cyan' | 'green' | 'white' | 'pink';
  label: string;
  value: string;
}

// Strip protocol for display in cards (linkedin.com/in/foo, github.com/bar)
const stripProto = (url: string) => url.replace(/^https?:\/\//, '');

const cards: ContactCard[] = [
  {
    href: `mailto:${profile.email}`,
    icon: '✉️',
    iconVariant: 'cyan',
    label: 'Email',
    value: profile.email,
  },
  {
    href: profile.linkedin_url,
    icon: '💼',
    iconVariant: 'green',
    label: 'LinkedIn',
    value: stripProto(profile.linkedin_url),
  },
  {
    href: profile.github_url,
    icon: '🐙',
    iconVariant: 'white',
    label: 'GitHub',
    value: stripProto(profile.github_url),
  },
  {
    href: '#',
    icon: '📍',
    iconVariant: 'pink',
    label: 'Location',
    value: profile.location,
  },
];

const tSection = lang === 'vi' ? 'Liên hệ' : 'Contact';
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="reveal">
    <div class="section-label">Reach out</div>
    <div class="section-title" id="contact-title">{tSection}</div>
  </div>
  <div class="contact-grid reveal">
    {cards.map((c) => (
      <a
        href={c.href}
        class="contact-card"
        target={c.href.startsWith('http') ? '_blank' : undefined}
        rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
      >
        <div class={`contact-icon contact-icon-${c.iconVariant}`} aria-hidden="true">{c.icon}</div>
        <div>
          <div class="contact-info-label">{c.label}</div>
          <div class="contact-info-value">{c.value}</div>
        </div>
      </a>
    ))}
  </div>

  <div class="contact-cta reveal">
    <h3>{profile.contact_cta_title}</h3>
    <p>{profile.contact_cta_body}</p>
    <a href={`mailto:${profile.email}`} class="contact-cta-btn">{profile.contact_cta_button}</a>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: inherit;
  }
  .contact-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-3px);
    box-shadow: 0 8px 32px rgba(0, 229, 255, 0.08);
  }

  /* Border shimmer FX */
  .contact-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -60%;
    width: 40%;
    height: 200%;
    background: linear-gradient(90deg, transparent, rgba(0, 229, 255, 0.08), transparent);
    transform: skewX(-20deg);
    transition: left 0.6s ease;
    pointer-events: none;
    z-index: -1;
  }
  .contact-card:hover::before { left: 130%; }

  .contact-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }
  .contact-icon-cyan  { background: rgba(0, 229, 255, 0.10); border: 1px solid rgba(0, 229, 255, 0.20); }
  .contact-icon-green { background: rgba(0, 255, 159, 0.10); border: 1px solid rgba(0, 255, 159, 0.20); }
  .contact-icon-pink  { background: rgba(255, 0, 255, 0.08); border: 1px solid rgba(255, 0, 255, 0.20); }
  .contact-icon-white { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.10); }

  .contact-info-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-secondary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 3px;
  }
  .contact-info-value {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  /* CTA card */
  .contact-cta {
    text-align: center;
    padding: 60px 24px;
    background: rgba(17, 24, 39, 0.4);
    border: 1px solid rgba(0, 229, 255, 0.10);
    border-radius: 24px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .contact-cta h3 {
    font-family: var(--font-headline);
    font-size: 32px;
    font-weight: 700;
    background: linear-gradient(90deg, #00E5FF, #00FF9F, #FF00FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    margin: 0 0 12px;
  }
  .contact-cta p {
    font-size: 16px;
    color: var(--color-text-secondary);
    margin: 0 auto 28px;
    max-width: 420px;
    line-height: 1.6;
  }
  .contact-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    border-radius: 12px;
    background: linear-gradient(135deg, #00FF9F, #00E5FF, #FF00FF);
    color: #0A0A0A;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 0 20px rgba(0, 255, 159, 0.3);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    position: relative;
    overflow: hidden;
  }
  .contact-cta-btn:hover {
    box-shadow: 0 0 36px rgba(0, 255, 159, 0.5);
    transform: scale(1.04) translateY(-1px);
  }
  .contact-cta-btn::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.5s ease, height 0.5s ease, opacity 0.5s ease;
    opacity: 0;
    pointer-events: none;
  }
  .contact-cta-btn:active::after {
    width: 300px; height: 300px;
    opacity: 0;
    transition: width 0.5s ease, height 0.5s ease, opacity 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card { transition: none; }
    .contact-card:hover { transform: none; }
    .contact-card::before { display: none; }
    .contact-cta-btn { transition: none; }
    .contact-cta-btn:hover { transform: none; }
  }
</style>
