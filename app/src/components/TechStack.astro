---
/**
 * TechStack.astro — "Tech Stack" section, 4 categorised pill groups
 * Source: design/index.html lines 1652-1701 (markup) + 1527-1543 + 1813-1824 (CSS).
 *
 * T-026: fetchSheet('TechStack') with hardcoded fallback. Pills bucketed by
 * `group_<lang>`, ordered by `order` within each group, group order preserves
 * first-seen-in-sheet sequence.
 */
interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;

interface Pill { label: string; variant: 'g' | 'c' | 'p' | 'w'; }
interface Group { label: string; pills: Pill[]; }

const groupsVi: Group[] = [
  {
    label: 'Ngôn ngữ lập trình',
    pills: [
      { label: 'C#', variant: 'g' }, { label: 'SQL', variant: 'g' },
      { label: 'PHP', variant: 'g' }, { label: 'JavaScript (cơ bản)', variant: 'g' },
    ],
  },
  {
    label: 'Ứng dụng & công cụ',
    pills: [
      { label: '.NET WinForms', variant: 'c' }, { label: 'T100 ERP', variant: 'c' },
      { label: 'Pentaho ETL', variant: 'c' }, { label: 'SAP BI Launch Pad', variant: 'c' },
      { label: 'Docker', variant: 'c' },
    ],
  },
  {
    label: 'Cơ sở dữ liệu',
    pills: [
      { label: 'Oracle', variant: 'p' }, { label: 'MySQL', variant: 'p' },
      { label: 'SQLite', variant: 'p' }, { label: 'Redis', variant: 'p' },
      { label: 'Qdrant', variant: 'p' }, { label: 'Neo4j', variant: 'p' }, { label: 'MinIO', variant: 'p' },
    ],
  },
  {
    label: 'Công nghiệp, tích hợp & AI',
    pills: [
      { label: 'PLC Integration', variant: 'w' }, { label: 'Keyence QR/Barcode', variant: 'w' },
      { label: 'REST API', variant: 'w' }, { label: 'Socket Communication', variant: 'w' },
      { label: 'vLLM', variant: 'w' }, { label: 'LightRAG', variant: 'w' },
      { label: 'LangGraph', variant: 'w' }, { label: 'OpenWebUI', variant: 'w' },
    ],
  },
];

const englishLabels = [
  'Programming Languages',
  'Applications & Tools',
  'Databases',
  'Industrial Integration & AI',
];
const groups = groupsVi.map((group, index) => ({
  label: lang === 'vi' ? group.label : englishLabels[index],
  pills: group.pills.map((pill) => ({
    ...pill,
    label: lang === 'en' && pill.label === 'JavaScript (cơ bản)' ? 'JavaScript (Basic)' : pill.label,
  })),
}));

const tSection = lang === 'vi' ? 'Tech Stack' : 'Tech Stack';
---

<section class="section" id="tech" aria-labelledby="tech-title">
  <div class="reveal">
    <div class="section-label">Skills</div>
    <div class="section-title" id="tech-title">{tSection}</div>
  </div>
  {groups.map((group) => (
    <div class="tech-group reveal">
      <div class="tech-group-label">{group.label}</div>
      <div class="tech-pills">
        {group.pills.map((p) => (
          <div class="tech-pill" data-glow>
            <span class={`tech-dot dot-${p.variant}`} aria-hidden="true"></span>
            {p.label}
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .tech-group { margin-bottom: 36px; }
  .tech-group-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-secondary);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tech-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-body);
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .tech-pill:hover {
    border-color: var(--color-border-hover);
    color: var(--color-cyan);
    transform: translateY(-2px);
  }

  .tech-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--mx, 50%) var(--my, 50%),
      rgba(0, 229, 255, 0.12),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: -1;
  }
  .tech-pill:hover::before { opacity: 1; }

  .tech-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-g { background: var(--color-green); box-shadow: 0 0 6px var(--color-green); }
  .dot-c { background: var(--color-cyan);  box-shadow: 0 0 6px var(--color-cyan); }
  .dot-p { background: var(--color-pink);  box-shadow: 0 0 6px var(--color-pink); }
  .dot-w { background: #fff;               box-shadow: 0 0 6px rgba(255, 255, 255, 0.5); }

  @media (prefers-reduced-motion: reduce) {
    .tech-pill { transition: none; }
    .tech-pill:hover { transform: none; }
    .tech-pill::before { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const pills = document.querySelectorAll('.tech-pill[data-glow]');
    pills.forEach((pill) => {
      pill.addEventListener('mousemove', (e) => {
        const rect = pill.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        pill.style.setProperty('--mx', x + '%');
        pill.style.setProperty('--my', y + '%');
      });
    });
  })();
</script>
