---
interface Props {
  experienceSummary_vi: string;
  experienceSummary_en: string;
  skillsTop_vi: string[];
  skillsTop_en: string[];
  yearsExperience: number;
  lang?: 'vi' | 'en';
}

const {
  experienceSummary_vi,
  experienceSummary_en,
  skillsTop_vi,
  skillsTop_en,
  yearsExperience,
  lang = "vi",
} = Astro.props;

const experienceSummary = lang === "en" ? experienceSummary_en : experienceSummary_vi;
const skillsTop = lang === "en" ? skillsTop_en : skillsTop_vi;

const summaryTitle = lang === "en" ? "Summary" : "Tóm tắt";
const skillsTitle = lang === "en" ? "Top Skills" : "Kỹ năng chính";
const experienceLabel = lang === "en" ? "Years Experience" : "Năm Kinh Nghiệm";
---

<section 
  class="bg-white py-12 md:py-16 px-6 md:px-16 flex flex-col items-start max-w-7xl mx-auto border-t border-zinc-100"
  aria-labelledby="summary-title"
>
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 w-full">
    
    <!-- Left Column: Title & Stats -->
    <div class="md:col-span-4 flex flex-col items-start">
      <h2 
        id="summary-title"
        class="text-2xl md:text-3xl font-medium tracking-tight text-zinc-900 mb-8"
      >
        {summaryTitle}
      </h2>
      
      <div class="mt-auto pt-8 md:pt-0">
        <div class="flex items-baseline gap-2">
          <span class="text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900">{yearsExperience}</span>
          <span class="text-lg text-emerald-500 font-medium">+</span>
        </div>
        <p class="text-sm font-medium tracking-wide uppercase text-zinc-500 mt-2">
          {experienceLabel}
        </p>
      </div>
    </div>

    <!-- Right Column: Content & Skills -->
    <div class="md:col-span-8 flex flex-col gap-10">
      
      <div class="prose prose-zinc prose-lg max-w-none font-light text-zinc-600 leading-relaxed">
        {experienceSummary.split('\n\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div>
        <h3 class="text-sm font-medium tracking-wide uppercase text-zinc-400 mb-4">
          {skillsTitle}
        </h3>
        <div class="flex flex-wrap gap-2">
          {skillsTop.map((skill) => (
            <span class="inline-flex items-center px-3 py-1.5 rounded-md bg-zinc-50 border border-zinc-200 text-sm font-medium text-zinc-700">
              {skill}
            </span>
          ))}
        </div>
      </div>
      
    </div>
    
  </div>
</section>
