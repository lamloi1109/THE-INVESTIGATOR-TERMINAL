---
/**
 * Education.astro — "Học vấn" section
 * Source: design/index.html lines 1705-1727 (markup) + 1545-1556 + 1841-1844 (CSS).
 *
 * T-026: fetchSheet('Education') with hardcoded fallback. Rows sorted by
 * `order` ascending. icon_variant only consumes `cyan` / `green`.
 */
import { fetchSheet } from '../lib/sheets';

interface Props { lang?: 'vi' | 'en'; }
const { lang = 'vi' } = Astro.props;

interface Edu {
  icon: string;
  iconVariant: 'cyan' | 'green';
  degree: string;
  school: string;
  year: string;
}

const FALLBACK_VI: Edu[] = [
  {
    icon: '🎓',
    iconVariant: 'cyan',
    degree: 'Kỹ thuật / Công nghệ thông tin',
    school: 'Đại học — Việt Nam',
    year: 'Đã tốt nghiệp',
  },
  {
    icon: '⚡',
    iconVariant: 'green',
    degree: 'Self-taught AI Engineer',
    school: 'Online Resources, Research Papers & Production Experience',
    year: '2022 – Present · Ongoing',
  },
];

function pickVariant(raw: string | undefined, fallback: 'cyan' | 'green'): 'cyan' | 'green' {
  if (raw === 'cyan' || raw === 'green') return raw;
  return fallback;
}

let items: Edu[] = [];
try {
  const rows = await fetchSheet('Education');
  items = rows
    .slice()
    .sort((a, b) => (a.order ?? 0) - (b.order ?? 0))
    .map((r, i) => ({
      icon: r.icon || '🎓',
      iconVariant: pickVariant(r.icon_variant, i % 2 === 0 ? 'cyan' : 'green'),
      degree: lang === 'vi' ? (r.degree_vi || r.degree_en) : (r.degree_en || r.degree_vi),
      school: lang === 'vi' ? (r.school_vi || r.school_en) : (r.school_en || r.school_vi),
      year: lang === 'vi' ? (r.year_vi || r.year_en) : (r.year_en || r.year_vi),
    }))
    .filter((e) => e.degree);
} catch (error) {
  console.warn('[Education] Sheets unavailable; using fallback.', error);
}
if (items.length === 0) items = FALLBACK_VI;

const tSection = lang === 'vi' ? 'Học vấn' : 'Education';
---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="reveal">
    <div class="section-label">Background</div>
    <div class="section-title" id="education-title">{tSection}</div>
  </div>
  {items.map((e) => (
    <div class="edu-card reveal">
      <div class={`edu-icon edu-icon-${e.iconVariant}`} aria-hidden="true">{e.icon}</div>
      <div>
        <div class="edu-degree">{e.degree}</div>
        <div class="edu-school">{e.school}</div>
        <div class="edu-year">{e.year}</div>
      </div>
    </div>
  ))}
</section>

<style>
  .edu-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 28px 32px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    margin-bottom: 16px;
    position: relative;
  }
  .edu-card:hover {
    border-color: rgba(0, 229, 255, 0.25);
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(0, 229, 255, 0.15),
      0 0 0 4px rgba(0, 229, 255, 0.04),
      0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .edu-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
  }
  .edu-icon-cyan {
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.2);
  }
  .edu-icon-green {
    background: rgba(0, 255, 159, 0.08);
    border: 1px solid rgba(0, 255, 159, 0.2);
  }

  .edu-degree {
    font-family: var(--font-headline);
    font-size: 19px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 4px;
  }
  .edu-school {
    font-size: 14px;
    color: var(--color-cyan);
    font-weight: 500;
    margin-bottom: 6px;
  }
  .edu-year {
    font-size: 12px;
    color: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .edu-card { transition: none; }
    .edu-card:hover { transform: none; box-shadow: none; }
  }
</style>
