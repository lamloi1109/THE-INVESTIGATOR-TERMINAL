---
/**
 * Experience.astro — "Kinh nghiệm làm việc" section
 * Source: design/index.html lines 1579-1600 (markup) + 1485-1506 + 1783-1797 (CSS).
 *
 * T-026: fetchSheet('Experience') with hardcoded VI fallback (S6 guarantee).
 * Rows sorted by `order` ascending. Achievements support inline <strong>
 * via set:html (bullets newline-separated in Sheets, Alt+Enter).
 */
interface Props {
  lang?: 'vi' | 'en';
}
const { lang = 'vi' } = Astro.props;

interface ExpItem {
  company: string;
  role: string;
  period: string;
  badge?: string;
  achievements: string[];
}

const items: ExpItem[] = [
  {
    company: 'Lê Long Vietnam',
    role: 'IT Specialist',
    period: '07/2023 – Hiện tại',
    badge: 'Đang làm việc',
    achievements: [
      'Phát triển và bảo trì ứng dụng <strong>C#/.NET WinForms</strong> phục vụ sản xuất ắc quy: truy xuất nguồn gốc, giám sát châm axit, quản lý điện áp và môi trường.',
      'Thiết kế, bảo trì cơ sở dữ liệu <strong>Oracle, MySQL và SQLite</strong>; tham gia luồng Pentaho ETL đồng bộ và báo cáo dữ liệu sản xuất.',
      'Tích hợp ứng dụng với <strong>PLC và máy quét QR Keyence</strong> để thu thập dữ liệu sản xuất, đo lường và cung cấp giám sát thời gian thực.',
      'Bảo trì hệ thống truy xuất QR010, hỗ trợ người dùng sản xuất và thực hiện báo cáo hiệu suất dây chuyền qua <strong>SAP BI Launch Pad</strong>.',
      'Phát triển quy trình ERP T100 và PHP API theo dõi CO₂, liên kết đơn hàng, thành phẩm và dữ liệu CO₂ cấp linh kiện.',
      'Thiết kế luồng giám sát môi trường hướng sự kiện bằng file-system events và socket communication, thay thế polling thư mục lặp lại.',
      'Nghiên cứu trợ lý tri thức AI on-premise với vLLM, LightRAG, LangGraph, Qdrant, Neo4j, Redis, MinIO và Docker để tra cứu tài liệu nội bộ.',
    ],
  },
  {
    company: 'SeaTek',
    role: 'Back-End Intern',
    period: '05/2022 – 08/2022',
    achievements: [
      'Hỗ trợ phát triển website bằng <strong>SOAP/Zimbra API</strong> cho chức năng email desktop và xác thực Firebase.',
      'Hỗ trợ triển khai server như cài đặt <strong>Oracle Database</strong> và <strong>Microsoft SQL Server</strong> trên phần cứng Intel NUC.',
    ],
  },
];

const tSection = lang === 'vi' ? 'Kinh nghiệm làm việc' : 'Work Experience';
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="reveal">
    <div class="section-label">Work</div>
    <div class="section-title" id="experience-title">{tSection}</div>
  </div>
  {items.map((item) => (
    <div class="exp-card reveal">
      <div>
        <div class="exp-company">{item.company}</div>
        <div class="exp-role">{item.role} · {item.period}</div>
        <ul class="exp-achievements">
          {item.achievements.map((a) => (
            <li set:html={a} />
          ))}
        </ul>
      </div>
      {item.badge && <span class="exp-badge">● {item.badge}</span>}
    </div>
  ))}
</section>

<style>
  .exp-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 32px 36px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: start;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    margin-bottom: 16px;
  }
  .exp-card:hover {
    border-color: rgba(0, 229, 255, 0.25);
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }
  @media (max-width: 640px) {
    .exp-card { grid-template-columns: 1fr; padding: 24px; }
  }

  .exp-company {
    font-family: var(--font-headline);
    font-size: 22px;
    font-weight: 700;
    background: linear-gradient(90deg, #00E5FF, #00FF9F);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 4px;
  }
  .exp-role {
    font-size: 14px;
    color: var(--color-text-secondary);
    font-weight: 500;
    margin-bottom: 20px;
  }
  .exp-achievements {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0;
    margin: 0;
  }
  .exp-achievements li {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-text-body);
    padding: 6px 8px 6px 28px;
    border-radius: 6px;
    position: relative;
    border-left: 1px solid transparent;
    transition: background 0.2s ease, color 0.2s ease, border-left-color 0.2s ease;
  }
  .exp-achievements li::before {
    content: '▸';
    position: absolute;
    left: 8px;
    top: 8px;
    color: var(--color-green);
    font-size: 12px;
  }
  .exp-achievements li:hover {
    background: rgba(0, 255, 159, 0.04);
    border-left-color: var(--color-green);
    color: var(--color-text-primary);
  }
  .exp-achievements li strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .exp-badge {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    height: fit-content;
    background: rgba(0, 255, 159, 0.08);
    border: 1px solid rgba(0, 255, 159, 0.25);
    color: var(--color-green);
  }
</style>
