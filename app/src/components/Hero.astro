---
/**
 * Hero.astro — "The Investigator" cyberpunk hero
 * Source: design/index.html lines 747-797
 *
 * Centered single-column hero. Badge -> gradient name -> subtitle ->
 * glassmorphic info-card (about + portrait status-ring) -> 3 CTAs ->
 * scroll indicator. All animations CSS-only via fx-fade-up-delay-* classes.
 *
 * Bilingual props preserved (D-004). English defaults match design copy.
 */
interface Props {
  name: string;                  // Display name (no i18n — proper noun)
  badge_vi?: string;             // "AI Engineer & Fullstack Developer"
  badge_en?: string;
  tagline_vi?: string;           // Subtitle under name
  tagline_en?: string;
  aboutLabel_vi?: string;        // "About Me" / "Giới thiệu"
  aboutLabel_en?: string;
  aboutBody_vi?: string;         // Plain text — strong emphasis applied via separate aboutHighlights
  aboutBody_en?: string;
  status_vi?: string;            // "● Available for work"
  status_en?: string;
  projectsHref?: string;         // Default /#projects
  contactHref?: string;          // Default /#contact
  resumeHref?: string;           // Default /resume.pdf
  portraitSrc?: string;          // Default /portrait.png
  portraitAlt?: string;
  lang?: 'vi' | 'en';
}

const {
  name,
  badge_vi = "Kỹ sư AI & Lập trình Fullstack",
  badge_en = "AI Engineer & Fullstack Developer",
  tagline_vi = "Xây dựng tương lai với AI và phát triển Full-Stack",
  tagline_en = "Building the Future with AI & Full-Stack Development",
  aboutLabel_vi = "Giới thiệu",
  aboutLabel_en = "About Me",
  aboutBody_vi = "Tôi là một <strong>Kỹ sư AI & Full-Stack Developer</strong> đam mê xây dựng các hệ thống thông minh giải quyết vấn đề thực tế. Chuyên sâu về <strong>tích hợp LLM, agentic pipelines</strong>, và ứng dụng web có khả năng mở rộng — nơi nghiên cứu chuyên sâu gặp gỡ code production.",
  aboutBody_en = "I'm an <strong>AI Engineer &amp; Full-Stack Developer</strong> passionate about building intelligent systems that solve real-world problems. I specialise in <strong>LLM integrations, agentic pipelines</strong>, and scalable web applications — where deep research meets production-grade code.",
  status_vi = "● Sẵn sàng làm việc",
  status_en = "● Available for work",
  projectsHref = "/#projects",
  contactHref = "/#contact",
  resumeHref = "/resume.pdf",
  portraitSrc = "/portrait.png",
  portraitAlt = "",
  lang = "en",
} = Astro.props;

const badge = lang === "vi" ? badge_vi : badge_en;
const tagline = lang === "vi" ? tagline_vi : tagline_en;
const aboutLabel = lang === "vi" ? aboutLabel_vi : aboutLabel_en;
const aboutBody = lang === "vi" ? aboutBody_vi : aboutBody_en;
const status = lang === "vi" ? status_vi : status_en;

const tProjects = lang === "vi" ? "Xem dự án" : "View Projects";
const tContact = lang === "vi" ? "Liên hệ" : "Contact Me";
const tResume = lang === "vi" ? "CV" : "Resume";
const tScroll = lang === "vi" ? "Cuộn" : "Scroll";
---

<section
  class="hero relative z-[2] min-h-screen flex flex-col items-center justify-center px-6 pt-20 pb-16 text-center"
  aria-labelledby="hero-name"
>
  <div class="hero-inner w-full max-w-[800px] flex flex-col items-center">
    <!-- Badge -->
    <div
      class="fx-fade-up-delay-2 inline-flex items-center gap-2 px-5 py-2 rounded-full bg-[rgba(0,255,159,0.08)] border border-[rgba(0,255,159,0.3)] text-sm font-medium text-green tracking-[0.02em]"
    >
      <span class="fx-pulse-dot w-[7px] h-[7px] rounded-full bg-green flex-shrink-0" style="box-shadow: 0 0 8px var(--color-green);" aria-hidden="true"></span>
      {badge}
    </div>

    <!-- Name (gradient) -->
    <h1
      id="hero-name"
      class="fx-fade-up-delay-3 gradient-text font-headline font-bold leading-[1.05] mt-6 tracking-[-0.01em]"
      style="font-size: clamp(48px, 4.5vw, 64px);"
    >
      {name}
    </h1>

    <!-- Subtitle -->
    <p class="fx-fade-up-delay-4 text-lg font-normal text-text-secondary max-w-[520px] leading-relaxed tracking-[0.03em] mt-4">
      {tagline}
    </p>

    <!-- Info card -->
    <div
      class="fx-fade-up-delay-5 group w-full max-w-[680px] mt-8 px-8 py-7 rounded-2xl bg-surface backdrop-blur-lg border border-border shadow-[0_0_30px_rgba(0,229,255,0.05)] flex items-center justify-between gap-6 text-left transition-[border-color,transform,box-shadow] duration-300 hover:border-border-hover hover:scale-[1.01] hover:shadow-[0_0_40px_rgba(0,229,255,0.1)]"
    >
      <div class="flex-1 min-w-0">
        <div class="font-label text-[11px] font-semibold text-cyan tracking-[0.15em] uppercase mb-2.5">
          {aboutLabel}
        </div>
        <p class="text-[15px] leading-[1.75] text-text-body font-normal" set:html={aboutBody} />
      </div>

      <div class="flex flex-col items-center gap-2.5 flex-shrink-0">
        <div
          class="fx-ring-pulse w-16 h-16 rounded-full border-2 border-green flex items-center justify-center bg-[rgba(0,255,159,0.05)] overflow-hidden"
        >
          <img
            src={portraitSrc}
            alt={portraitAlt || name}
            width="64"
            height="64"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover rounded-full block"
          />
        </div>
        <div class="text-[11px] font-semibold text-green tracking-[0.05em] whitespace-nowrap text-center">
          {status}
        </div>
      </div>
    </div>

    <!-- Buttons -->
    <div class="fx-fade-up-delay-6 flex flex-wrap items-center justify-center gap-3.5 mt-10">
      <!-- Secondary: View Projects -->
      <a
        href={projectsHref}
        aria-label={tProjects}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-surface-strong border border-[rgba(0,229,255,0.2)] text-text-primary font-body text-[15px] font-semibold tracking-[0.02em] no-underline whitespace-nowrap hover:text-cyan hover:border-[rgba(0,229,255,0.5)] hover:shadow-[0_0_16px_rgba(0,229,255,0.15)] hover:-translate-y-0.5 transition-all duration-200"
      >
        {tProjects} &nbsp;→
      </a>

      <!-- Primary: Contact (gradient) -->
      <a
        href={contactHref}
        aria-label={tContact}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-bg font-body text-[15px] font-semibold tracking-[0.02em] no-underline whitespace-nowrap shadow-[0_0_20px_rgba(0,255,159,0.3)] hover:shadow-[0_0_36px_rgba(0,255,159,0.5)] hover:scale-[1.04] hover:-translate-y-px transition-all duration-200"
        style="background: linear-gradient(135deg, #00FF9F, #00E5FF, #FF00FF);"
      >
        {tContact}
      </a>

      <!-- Secondary: Resume -->
      <a
        href={resumeHref}
        target={resumeHref.endsWith('.pdf') ? '_blank' : undefined}
        rel={resumeHref.endsWith('.pdf') ? 'noopener noreferrer' : undefined}
        aria-label={tResume}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-surface-strong border border-[rgba(0,229,255,0.2)] text-text-primary font-body text-[15px] font-semibold tracking-[0.02em] no-underline whitespace-nowrap hover:text-cyan hover:border-[rgba(0,229,255,0.5)] hover:shadow-[0_0_16px_rgba(0,229,255,0.15)] hover:-translate-y-0.5 transition-all duration-200"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 1v8M4 6l3 3 3-3M2 11h10" />
        </svg>
        {tResume}
      </a>
    </div>
  </div>

  <!-- Scroll indicator (absolute bottom) -->
  <div class="fx-fade-in-late absolute bottom-9 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 text-text-secondary text-xs tracking-[0.08em]">
    <span class="fx-bounce-arrow text-lg leading-none" aria-hidden="true">↓</span>
    <span>{tScroll}</span>
  </div>
</section>
